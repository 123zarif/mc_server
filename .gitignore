# ===================================================================
# Environment & Secrets (NEVER COMMIT THESE)
# ===================================================================
.env
*.env
*.pem
*.key
forwarding.secret

# ===================================================================
# Jar Handling: Ignore all .jar files everywhere (auto-downloaded)
# ===================================================================
*.jar
**/*.jar

# ===================================================================
# Disposable Runtime Server Data Volumes (Templates live in config/)
# ===================================================================
/survival-data/
/pvp-data/
/proxy-data/

# ===================================================================
# Minecraft Server Runtime Bloat (Keep repo clean)
# ===================================================================
*.log
*.log.gz
**/logs/
**/crash-reports/
**/cache/
**/libraries/
**/versions/
**/.paper-remapped/
**/.paper/
**/.purpur-manifest.json
**/.papermc-manifest.json
**/.rcon-cli.yaml
**/.rcon-cli.env
**/.purpur.env
**/.results.env
**/eula.txt

# Server player cache & access lists
**/usercache.json
**/banned-ips.json
**/banned-players.json
**/ops.json
**/whitelist.json

# Ignore heavy world chunks and player states
**/world/
**/world_nether/
**/world_the_end/
**/playerdata/
**/stats/
**/region/
**/entities/
**/poi/

# ===================================================================
# Plugin Runtime Data (Allow configs, ignore player/db bloat)
# ===================================================================
# Plugins write SQLite databases, backups, and user states inside their folders
**/plugins/**/userdata/
**/plugins/**/playerdata/
**/plugins/**/backups/
**/plugins/**/Backup/
**/plugins/**/Save/
**/plugins/**/Saves/
**/plugins/**/cache/
**/plugins/**/tmp/
**/plugins/**/lib/
**/plugins/**/data/
**/plugins/**/*.db
**/plugins/**/*.sqlite
**/plugins/**/*.sqlite3
**/plugins/**/*.bin
**/plugins/Essentials/upgrades-done.yml
**/plugins/squaremap/web/tiles/

# ===================================================================
# Rust Build Artifacts
# ===================================================================
/rust-backend/target/

# ===================================================================
# Node / Expo Artifacts
# ===================================================================
/expo-app/node_modules/
/expo-app/.expo/
/expo-app/dist/
/expo-app/web-build/
.npm
.yarn/

# ===================================================================
# OS Specific
# ===================================================================
.DS_Store
Thumbs.db
