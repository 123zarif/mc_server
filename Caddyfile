{
    # Global options
}

# ===================================================================
# Direct Port Access (e.g. http://localhost:3001 or http://<vps-ip>:3001)
# ===================================================================
:3001 {
    # Ensure trailing slash so relative assets (./assets, ./tiles) resolve properly
    redir /map /map/ permanent
    handle_path /map/* {
        reverse_proxy mc-survival:8080
    }

    handle /api/* {
        reverse_proxy mc-dashboard-api:4000
    }

    handle /ws/* {
        reverse_proxy mc-dashboard-api:4000
    }

    handle {
        reverse_proxy mc-dashboard-web:3000
    }
}

# ===================================================================
# Main Domain & Subdomains (zarifzuhayer.tech)
# ===================================================================
http://map.zarifzuhayer.tech, map.zarifzuhayer.tech {
    reverse_proxy mc-survival:8080
}

http://zarifzuhayer.tech, zarifzuhayer.tech {
    # Ensure trailing slash so relative assets (./assets, ./tiles) resolve properly
    redir /map /map/ permanent
    handle_path /map/* {
        reverse_proxy mc-survival:8080
    }

    handle /api/* {
        reverse_proxy mc-dashboard-api:4000
    }

    handle /ws/* {
        reverse_proxy mc-dashboard-api:4000
    }

    handle {
        reverse_proxy mc-dashboard-web:3000
    }
}

# ===================================================================
# Syncplay Server (sync.zarifzuhayer.tech)
# Obtains and renews automated Let's Encrypt TLS certificates
# ===================================================================
sync.zarifzuhayer.tech {
    respond "Syncplay server endpoint" 200
}
