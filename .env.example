# ===================================================================
# SECRETS (Required in production)
# ===================================================================
POSTGRES_DB=mc_server
POSTGRES_USER=admin
POSTGRES_PASSWORD=Random123

DISCORD_TOKEN=your_discord_bot_token_from_developer_portal

# ===================================================================
# SYSTEM & ENVIRONMENT
# ===================================================================
TZ=UTC

# ===================================================================
# MEMORY ALLOCATION (Total: ~18GB, tuned for 24GB Oracle Ampere A1)
# ===================================================================
VELOCITY_MEMORY=512M

SURVIVAL_MEMORY=10G
SURVIVAL_MEMORY_LIMIT=12G

PVP_MEMORY=3G
PVP_MEMORY_LIMIT=4G

# ===================================================================
# MINECRAFT CONFIGURATION
# ===================================================================
MC_TYPE=PURPUR
MC_VERSION=26.2
MC_DIFFICULTY=hard

SURVIVAL_VIEW_DISTANCE=8
SURVIVAL_SIM_DISTANCE=6

PVP_VIEW_DISTANCE=6
PVP_SIM_DISTANCE=4

# ===================================================================
# PORTS
# ===================================================================
MINECRAFT_JAVA_PORT=25565
MINECRAFT_BEDROCK_PORT=19132
VOICE_CHAT_PORT=24454
HTTP_PORT=80
HTTPS_PORT=443
